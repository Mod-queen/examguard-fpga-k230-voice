# ACX750-CH569 RTL8211F Ethernet, RGMII TX and MDIO.
# Re-integrated 2026-09-22; PHY management is write-only, so eth_mdio never
# needs the FPGA input path. The 125 MHz GMII clock is derived from the
# 50 MHz system clock by eth_mmcm and constrained by the generated clock.
set_property PACKAGE_PIN AB21 [get_ports eth_gtx_clk]
set_property PACKAGE_PIN AB20 [get_ports {eth_txd[0]}]
set_property PACKAGE_PIN Y19  [get_ports {eth_txd[1]}]
set_property PACKAGE_PIN AB22 [get_ports {eth_txd[2]}]
set_property PACKAGE_PIN W20  [get_ports {eth_txd[3]}]
set_property PACKAGE_PIN AA19 [get_ports eth_txen]
set_property PACKAGE_PIN P14  [get_ports eth_rst_n]
set_property PACKAGE_PIN R14  [get_ports eth_mdc]
set_property PACKAGE_PIN U21  [get_ports eth_mdio]
set_property IOSTANDARD LVCMOS33 [get_ports eth_gtx_clk]
set_property IOSTANDARD LVCMOS33 [get_ports {eth_txd[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {eth_txd[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {eth_txd[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {eth_txd[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports eth_txen]
set_property IOSTANDARD LVCMOS33 [get_ports eth_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports eth_mdc]
set_property IOSTANDARD LVCMOS33 [get_ports eth_mdio]
set_property PULLUP true [get_ports eth_mdio]

# Hiwonder WonderEcho voice assistant I2C master on the GPIO0 expansion header
# (silkscreen P11). SCL/SDA are open drain with 3.3 V pull-ups; these two pins
# are free (not used by the MIG/DDR3, camera, display, Ethernet or keys).
#   SCL = C14 (GPIO0_26)
#   SDA = C15 (GPIO0_27)
set_property PACKAGE_PIN C14 [get_ports voice_scl]
set_property PACKAGE_PIN C15 [get_ports voice_sda]
set_property IOSTANDARD LVCMOS33 [get_ports voice_scl]
set_property IOSTANDARD LVCMOS33 [get_ports voice_sda]
set_property PULLUP true [get_ports voice_scl]
set_property PULLUP true [get_ports voice_sda]

# ExamGuard K230 vision module UART on the GPIO0 expansion header.
#   ai_uart_tx = E13 (GPIO0_28) -> K230 RX
#   ai_uart_rx = E14 (GPIO0_29) <- K230 TX
set_property PACKAGE_PIN E13 [get_ports ai_uart_tx]
set_property PACKAGE_PIN E14 [get_ports ai_uart_rx]
set_property IOSTANDARD LVCMOS33 [get_ports ai_uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports ai_uart_rx]
set_property PULLUP true [get_ports ai_uart_rx]
