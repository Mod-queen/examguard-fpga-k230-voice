set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets camera_pclk_IBUF]

#HDMI
set_property PACKAGE_PIN H19 [get_ports hdmi_clk_n]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_clk_n]
set_property PACKAGE_PIN J19 [get_ports hdmi_clk_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_clk_p]
set_property PACKAGE_PIN K22 [get_ports {hdmi_dat_n[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_n[0]}]
set_property PACKAGE_PIN K21 [get_ports {hdmi_dat_p[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[0]}]
set_property PACKAGE_PIN J21 [get_ports {hdmi_dat_n[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_n[1]}]
set_property PACKAGE_PIN J20 [get_ports {hdmi_dat_p[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[1]}]
set_property PACKAGE_PIN H22 [get_ports {hdmi_dat_n[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_n[2]}]
set_property PACKAGE_PIN J22 [get_ports {hdmi_dat_p[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_dat_p[2]}]
set_property PACKAGE_PIN M22 [get_ports hdmi_oe]
set_property IOSTANDARD LVCMOS33 [get_ports hdmi_oe]

#UART and passive buzzer. The ACX750-CH569 board manual and official
#pwm_gen/music_gen examples assign the buzzer to P17.
set_property PACKAGE_PIN M21 [get_ports uart_txd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_txd]
set_property PACKAGE_PIN L21 [get_ports uart_rxd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_rxd]
set_property PACKAGE_PIN P17 [get_ports beep]
set_property IOSTANDARD LVCMOS33 [get_ports beep]
# UART and buzzer are asynchronous external endpoints, not synchronous data
# buses. Exclude them from output-delay analysis.
set_false_path -to [get_ports {uart_txd beep}]

#User keys, active low. key[0] is S[1] because S[0] (D21) is the reset button.
set_property PACKAGE_PIN E21 [get_ports {key[0]}]
set_property PACKAGE_PIN G22 [get_ports {key[1]}]
set_property PACKAGE_PIN G21 [get_ports {key[2]}]
set_property PACKAGE_PIN B22 [get_ports {key[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key[3]}]
set_property PULLUP true [get_ports {key[0]}]
set_property PULLUP true [get_ports {key[1]}]
set_property PULLUP true [get_ports {key[2]}]
set_property PULLUP true [get_ports {key[3]}]

#8-digit 7-segment display over the 74HC595 three-wire interface
set_property PACKAGE_PIN U20 [get_ports seg7_dio]
set_property PACKAGE_PIN V20 [get_ports seg7_rclk]
set_property PACKAGE_PIN T21 [get_ports seg7_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports seg7_dio]
set_property IOSTANDARD LVCMOS33 [get_ports seg7_rclk]
set_property IOSTANDARD LVCMOS33 [get_ports seg7_sclk]
# The shift register is a slow external endpoint, not a synchronous bus.
set_false_path -to [get_ports {seg7_dio seg7_rclk seg7_sclk}]

