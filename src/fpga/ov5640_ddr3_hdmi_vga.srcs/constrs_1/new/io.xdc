#set UnusedPin
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

#system slock
set_property PACKAGE_PIN W19 [get_ports clk50m]
set_property IOSTANDARD LVCMOS33 [get_ports clk50m]

#reset active low,
set_property PACKAGE_PIN D21 [get_ports reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports reset_n]

#led
set_property IOSTANDARD LVCMOS33 [get_ports {switches[*]}]
set_property PACKAGE_PIN B21 [get_ports {switches[0]}]
set_property PACKAGE_PIN C22 [get_ports {switches[1]}]
set_property PACKAGE_PIN E22 [get_ports {switches[2]}]
set_property PACKAGE_PIN D22 [get_ports {switches[3]}]
set_property PACKAGE_PIN F15 [get_ports {switches[4]}]
set_property PACKAGE_PIN F21 [get_ports {switches[5]}]
set_property PACKAGE_PIN D20 [get_ports {switches[6]}]
set_property PACKAGE_PIN C20 [get_ports {switches[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]
set_property PACKAGE_PIN W21 [get_ports {led[2]}]
set_property PACKAGE_PIN V22 [get_ports {led[1]}]
set_property PACKAGE_PIN U22 [get_ports {led[0]}]


